1. Login Query

GET /json-c360-authentication*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "record.UserAgent.keyword": "MOBILE" }},
        { "term": { "record.USERTYPE.keyword": "B" }},
        { "term": { "record.appName.keyword": "universal-customer-login-api" }},
        { "term": { "record.AGREGATOR_bool.keyword": "false" }}
      ]
    }
  }
}


2. Fund Transfer Query

GET /json-c360-authentication*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "record.CONTEXT_PATH": "/bank/deposits/pay/transfer/create/v1/create" }},
        { "term": { "record.appName": "auth-edge-router-bank-deposits" }},
        { "term": { "record.AGREGATOR": "false" }},
        { "term": { "record.Client": "Mobile-App" }}
      ]
    }
  }
}


