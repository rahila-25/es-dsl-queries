GET json-call-center-bank-org-*/_search?filter_path=aggregations.total.sum
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*/dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}},
        {
          "range": {
            "@timestamp": {
              "gte": "now-7d/d",
              "lte": "now"
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "customer_unique_ids": {
      "terms": {
        "field": "record.cif.keyword",
        "size": 10000
      }
    },
    "customer_count": {
      "stats_bucket": {
        "buckets_path": "customer_unique_ids._count"
      }
    },

    "agent_unique_ids": {
      "terms": {
        "field": "record.racf.keyword",
        "size": 10000
      }
    },
    "agent_count": {
      "stats_bucket": {
        "buckets_path": "agent_unique_ids._count"
      }
    },

    "total": {
      "stats_bucket": {
        "buckets_path": [
          "customer_count.count",
          "agent_count.count"
        ]
      }
    }
  }
}
