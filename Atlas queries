GET json-call-center-bank-org-*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*/dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}},
        {
          "range": {
            "@timestamp": {
              "gte": "now-7d/d",
              "lte": "now"
            }
          }
        }
      ]
    }
  },
  "aggs": {

    "business_impact": {
      "filters": {
        "filters": {

          "customer_logic": {
            "exists": {
              "field": "record.cif.keyword"
            }
          },

          "agent_logic": {
            "exists": {
              "field": "record.racf.keyword"
            }
          }

        }
      },

      "aggs": {

        "unique_ids": {
          "terms": {
            "field": "record.cif.keyword",
            "size": 10000
          }
        },

        "unique_agent_ids": {
          "terms": {
            "field": "record.racf.keyword",
            "size": 10000
          }
        },

        "customer_count": {
          "stats_bucket": {
            "buckets_path": "unique_ids._count"
          }
        },

        "agent_count": {
          "stats_bucket": {
            "buckets_path": "unique_agent_ids._count"
          }
        }

      }
    },

    "total_count": {
      "stats_bucket": {
        "buckets_path": [
          "business_impact>customer_count.count",
          "business_impact>agent_count.count"
        ]
      }
    }

  }
}
