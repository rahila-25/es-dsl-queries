GET json-call-center-bank-org-*/_search?filter_path=aggregations
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*/dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}}
      ],
      "must_not": [
        { "term": { "record.racfid.keyword": "unknown" }}
      ]
    }
  },
  "aggs": {
    "group_by_agent": {
      "terms": {
        "field": "record.racfid.keyword",
        "size": 10000
      }
    },
    "data": {
      "stats_bucket": {
        "buckets_path": "group_by_agent._count"
      }
    }
  }
}
