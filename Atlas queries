GET logs-*/_search
{
  "query": {
    "bool": {
      "must": [
        { "term": { "cls.application.keyword": "epp-settlement-batch-filetransfer" }},
        { "term": { "cls.environment.keyword": "prod" }},
        { "term": { "level.keyword": "ERROR" }},
        {
          "wildcard": {
            "message.keyword": "*Missed Business SLA*"
          }
        }
      ]
    }
  }
}
