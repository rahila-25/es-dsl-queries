GET logs-*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "cls.application.keyword": "epp-settlement-batch-filetransfer" }},
        { "wildcard": { "cls.environment.keyword": "prod*" }},
        { "term": { "level.keyword": "ERROR" }},
        { "match_phrase": { "message": "Missed Business SLA" }}
      ],
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-30d",
              "lte": "now"
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "impact_count": {
      "value_count": {
        "field": "message.keyword"
      }
    }
  }
}
