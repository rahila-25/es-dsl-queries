GET /json-call-center-bank-org-*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}}
      ]
    }
  },
  "aggs": {

    "data": {
      "stats": {
        "field": "record.HTTP_STATUS_CODE_int"
      }
    },

    "total_count_before_dedup": {
      "value_count": {
        "field": "record.context.RequestId.keyword"
      }
    },

    "unique_count_after_dedup": {
      "cardinality": {
        "field": "record.context.RequestId.keyword"
      }
    },

    "by_racf": {
      "terms": {
        "field": "record.racf.keyword",
        "size": 10000
      },
      "aggs": {
        "disruption_count": {
          "value_count": {
            "field": "record.context.RequestId.keyword"
          }
        },
        "unique_per_racf": {
          "cardinality": {
            "field": "record.context.RequestId.keyword"
          }
        }
      }
    }

  }
}
