GET json-call-center-bank-org-*/_search?filter_path=aggregations.total.value
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*/dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}},
        {
          "range": {
            "@timestamp": {
              "gte": "now-7d/d",
              "lte": "now"
            }
          }
        }
      ]
    }
  },
  "aggs": {

    "customer_group": {
      "terms": {
        "field": "record.cif.keyword",
        "size": 10000
      }
    },

    "customer_count": {
      "stats_bucket": {
        "buckets_path": "customer_group._count"
      }
    },

    "agent_group": {
      "terms": {
        "field": "record.racf.keyword",
        "size": 10000
      }
    },

    "agent_count": {
      "stats_bucket": {
        "buckets_path": "agent_group._count"
      }
    },

    "total": {
      "bucket_script": {
        "buckets_path": {
          "c": "customer_count.sum",
          "a": "agent_count.sum"
        },
        "script": "params.c + params.a"
      }
    }

  }
}
