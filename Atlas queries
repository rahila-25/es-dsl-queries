GET json-call-center-bank-org-*/_search?filter_path=aggregations.total.data

{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*/dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}},
        {
          "range": {
            "@timestamp": {
              "gte": "now-7d/d",
              "lte": "now"
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "total": {
      "filters": {
        "filters": {
          "all_docs": { "match_all": {} }
        }
      },
      "aggs": {

        "customer_count": {
          "cardinality": {
            "field": "record.cif.keyword"
          }
        },

        "agent_count": {
          "cardinality": {
            "field": "record.racf.keyword"
          }
        },

        "data": {
          "bucket_script": {
            "buckets_path": {
              "c": "customer_count",
              "a": "agent_count"
            },
            "script": "params.c + params.a"
          }
        }

      }
    }
  }
}
