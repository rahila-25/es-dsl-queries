{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "{{start}}",
              "lte": "{{end}}",
              "format": "epoch_second"
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "unique_regid_count": {
      "cardinality": {
        "field": "record.REGID.keyword",
        "precision_threshold": 40000
      }
    }
  }
}
