GET json-call-center-bank-org-*/_search?filter_path=aggregations
{
  "size": 0,

  "runtime_mappings": {
    "racftrim": {
      "type": "keyword",
      "script": """
        if (doc.containsKey('record.message.keyword') && !doc['record.message.keyword'].empty) {
          String msg = doc['record.message.keyword'].value;
          def matcher = /[a-zA-Z0-9]+/.matcher(msg);
          if (matcher.find()) {
            emit(matcher.group());
          }
        }
      """
    }
  },

  "query": {
    "bool": {
      "must": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*/dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}}
      ]
    }
  },

  "aggs": {
    "group_by_agent": {
      "terms": {
        "field": "racftrim",
        "size": 10000
      }
    },
    "data": {
      "stats_bucket": {
        "buckets_path": "group_by_agent._count"
      }
    }
  }
}
