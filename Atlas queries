GET logs-*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        {
          "match": {
            "cls.application.keyword": "epp-settlement-batch-filetransfer"
          }
        },
        {
          "wildcard": {
            "cls.environment.keyword": "prod*"
          }
        },
        {
          "term": {
            "level.keyword": "ERROR"
          }
        },
        {
          "wildcard": {
            "message": "*Missed*Business*SLA*"
          }
        }
      ],
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-24h",
              "lte": "now"
            }
          }
        }
      ]
    }
  },
  "track_total_hits": true
}
