{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        { "term": { "record.dd.env.keyword": "prod" }},
        { "term": { "record.appName.keyword": "bank-atlas-platform-router" }},
        { "wildcard": { "record.CONTEXT_PATH.keyword": "*dropdown/v1/data/dropdowns*" }},
        { "range": { "record.HTTP_STATUS_CODE_int": { "gte": 500 }}}
      ]
    }
  },
  "aggs": {
    "by_racf": {
      "terms": {
        "field": "record.racf.keyword",
        "size": 10000,
        "shard_size": 10000
      },
      "aggs": {
        "disruption_count": {
          "value_count": {
            "field": "_index"
          }
        },
        "unique_count": {
          "cardinality": {
            "field": "record.racf.keyword"
          }
        },
        "disruption_stats": {
          "stats": {
            "field": "_index"
          }
        }
      }
    },
    "unique_request_ids": {
      "terms": {
        "field": "record.context.RequestId.keyword",
        "size": 10000
      },
      "aggs": {
        "request_count": {
          "value_count": {
            "field": "_index"
          }
        },
        "request_stats": {
          "stats": {
            "field": "_index"
          }
        },
        "count": {
          "stats_bucket": {
            "buckets_path": "unique_request_ids_count"
          }
        }
      }
    }
  }
}
