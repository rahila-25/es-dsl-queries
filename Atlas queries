GET logs-*/_search
{
  "size": 0,
  "query": {
    "bool": {
      "must": [
        {
          "term": {
            "cls.application.keyword": "epp-settlement-batch-filetransfer"
          }
        },
        {
          "term": {
            "cls.environment.keyword": "prod"
          }
        },
        {
          "term": {
            "level.keyword": "ERROR"
          }
        },
        {
          "match_phrase": {
            "message": "Missed Business SLA"
          }
        }
      ]
    }
  }
}
