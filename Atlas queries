GET logs-*/_search?filter_path=aggregations.unique_cifid.value
{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        { "term": { "kubernetes.namespace.keyword": "mobile-check-deposit-prod" } },
        {
          "terms": {
            "message.keyword": [
              "Enrollment status requested",
              "Enroll operation requested",
              "Deposit limit requested",
              "Verify deposit requested",
              "Submit deposit requested"
            ]
          }
        },
        {
          "range": {
            "@timestamp": {
              "gte": {{start}},
              "lte": {{end}},
              "format": "epoch_second"
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "unique_cifid": {
      "cardinality": {
        "field": "cifId.keyword",
        "precision_threshold": 40000
      }
    }
  }
}
